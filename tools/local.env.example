# Copy to tools/local.env (not tracked) and set the paths of this machine.
# tools/fcq and the freecad-worker agent read these values.

# Headless launcher: a wrapper that runs freecadcmd with the CAD-AI profile
# (--user-cfg/--system-cfg and FREECAD_USER_HOME/DATA/TEMP)
FREECAD_LAUNCHER=/path/to/launchers/freecadcmd-codex

# GUI launcher with the same profile, for GUI-macro runs
FREECAD_GUI_LAUNCHER=/path/to/launchers/FreeCAD-Codex.command

# Python for helper scripts that do not need FreeCAD (reading JSON, tools/parts_check.py); run with -I
CAD_PY=/path/to/.venv/bin/python
